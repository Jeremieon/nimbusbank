POSTGRES_USER=nimbusbank
POSTGRES_PASSWORD=change_me_please
# Maintenance/default database the postgres image bootstraps with. The real
# app databases (auth, accounts, transfers, kyc, support) are created by
# postgres/init-multi-db.sh on first startup — see README.
POSTGRES_DB=postgres

# Access tokens are short-lived on purpose (JWT validation at the edge is
# one of the things this app exists to demo against F5 XC).
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# How long a login OTP stays valid. Kept short, but nothing rate-limits
# guesses against it — see README's INTENTIONALLY VULNERABLE table.
OTP_EXPIRE_MINUTES=5

# Reserved for later phases — not yet enforced anywhere
SECURITY_LEVEL=vulnerable

# Only used by each service's CORS config for local `npm run dev` (Vite on
# 5173). In docker-compose, frontend + all three services are same-origin
# via the gateway, so this isn't actually exercised in production-style
# deployment.
FRONTEND_ORIGIN=http://localhost:5173

# Set to true once this sits behind HTTPS (e.g. once F5 XC is in front)
COOKIE_SECURE=false

HTTP_PORT=80
